# --- Copiez ce fichier en ".env" puis remplissez les valeurs ---
# NE JAMAIS partager ce fichier ni le mettre dans l'application mobile.

# Clé API Anthropic (Claude) : https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Supabase : Project Settings -> API
SUPABASE_URL=
# "service_role" (secrète !) : uniquement côté serveur
SUPABASE_SERVICE_ROLE_KEY=

# Modèle IA (laisser par défaut)
CLAUDE_MODEL=claude-opus-5-5

# Port du serveur
PORT=8787

# Limites de consommation par utilisateur et par jour
DAILY_MESSAGE_LIMIT=200
DAILY_IMAGE_LIMIT=400

# Origines web autorisées (laisser vide pour l'app mobile)
CORS_ORIGINS=

# Mode développement SANS Supabase (tests locaux uniquement, refusé en production)
ALLOW_DEV_AUTH=false
