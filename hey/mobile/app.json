{
  "expo": {
    "name": "HEY",
    "slug": "hey",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hey",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.heyassistant.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.heyassistant.app",
      "adaptiveIcon": {
        "backgroundColor": "#5B5BF6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B5BF6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "HEY utilise la caméra pendant un appel vidéo pour voir ce que vous lui montrez. Aucune vidéo n'est enregistrée.",
          "microphonePermission": "HEY utilise le micro pour vous entendre pendant la conversation.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "HEY utilise le micro pour vous entendre pendant la conversation. L'audio n'est pas enregistré.",
          "speechRecognitionPermission": "HEY transforme votre voix en texte pour comprendre vos questions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
