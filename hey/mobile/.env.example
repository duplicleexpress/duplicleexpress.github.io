# Copiez ce fichier en ".env" puis remplissez les valeurs.
# Ces valeurs sont PUBLIQUES (pas de clé secrète ici) : la clé de l'IA reste sur le serveur.

# Adresse du serveur HEY (ex. https://hey-server.onrender.com)
EXPO_PUBLIC_API_URL=

# Supabase : Project Settings -> API -> Project URL et clé "anon public"
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
